Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", "ASER", " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     SubscriptBox["N", "0"], "=", " ", 
     RowBox[{"RandomVariate", "[", 
      RowBox[{
       RowBox[{"NormalDistribution", "[", 
        RowBox[{"0", ",", 
         SqrtBox[
          FractionBox["1", "2"]]}], "]"}], ",", "samples"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"snr", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       SuperscriptBox["10", 
        FractionBox["l", "10"]], ",", 
       RowBox[{"{", 
        RowBox[{"l", ",", 
         RowBox[{"-", "25"}], ",", "20", ",", "2"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"pr", "=", 
     RowBox[{"Table", "[", 
      RowBox[{"0", ",", 
       RowBox[{"{", 
        RowBox[{"Length", "[", "snr", "]"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{
       SubscriptBox["ASERmc", "i"], "=", "0"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", 
        RowBox[{"Length", "[", "M", "]"}]}], "}"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"g", "=", "1"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"For", "[", 
     RowBox[{
      RowBox[{"j", "=", "1"}], ",", 
      RowBox[{"j", "\[LessEqual]", 
       RowBox[{"Length", "[", "M", "]"}]}], ",", 
      RowBox[{"j", "++"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"H1", "=", 
        SubscriptBox["H", "j"]}], ";", "\[IndentingNewLine]", 
       RowBox[{"For", "[", 
        RowBox[{
         RowBox[{"l", "=", "1"}], ",", 
         RowBox[{"l", "\[LessEqual]", 
          RowBox[{"Length", "[", "snr", "]"}]}], ",", 
         RowBox[{"l", "++"}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"\[Rho]1", "=", 
           RowBox[{
            RowBox[{"snr", "[", 
             RowBox[{"[", "l", "]"}], "]"}], 
            FractionBox[
             SuperscriptBox["H1", "2"], 
             RowBox[{"M", "[", 
              RowBox[{"[", "j", "]"}], "]"}]]}]}], ";", 
          RowBox[{"cl", "=", "0"}], ";", "\[IndentingNewLine]", 
          RowBox[{"cl", "=", 
           RowBox[{"Total", "[", 
            RowBox[{"UnitStep", "[", 
             RowBox[{
              SubscriptBox["N", "0"], "-", 
              SqrtBox[
               RowBox[{"g", " ", "\[Rho]1"}]]}], "]"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"pr", "[", 
            RowBox[{"[", "l", "]"}], "]"}], "=", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"N", "[", 
              RowBox[{"10", 
               RowBox[{"Log10", "[", 
                RowBox[{"snr", "[", 
                 RowBox[{"[", "l", "]"}], "]"}], "]"}]}], "]"}], ",", 
             RowBox[{"N", "[", 
              RowBox[{
               RowBox[{"cl", "/", "samples"}], ",", "600"}], "]"}]}], "}"}]}],
           ";"}]}], "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{
        SubscriptBox["ASERmc", "j"], "=", "pr"}], ";"}]}], 
     "\[IndentingNewLine]", "]"}], ";"}]}]}]], "Input",
