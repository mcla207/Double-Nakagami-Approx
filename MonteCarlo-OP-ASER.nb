Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", "OP", " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"\[Gamma]0", "=", "1"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"snr", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       SuperscriptBox["10", 
        FractionBox["l", "10"]], ",", 
       RowBox[{"{", 
        RowBox[{"l", ",", 
         RowBox[{"-", "25"}], ",", "5", ",", "2"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{
       SubscriptBox["OPmc", "i"], "=", "0"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", 
        RowBox[{"Length", "[", "M", "]"}]}], "}"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"pr", "=", 
     RowBox[{"Table", "[", 
      RowBox[{"0", ",", 
       RowBox[{"{", 
        RowBox[{"Length", "[", "snr", "]"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"For", "[", 
     RowBox[{
      RowBox[{"i", "=", "1"}], ",", 
      RowBox[{"i", "<=", 
       RowBox[{"Length", "[", "M", "]"}]}], ",", 
      RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"H1", "=", 
        SubscriptBox["H", "i"]}], ";", "\[IndentingNewLine]", 
       RowBox[{"For", "[", 
        RowBox[{
         RowBox[{"j", "=", "1"}], ",", 
         RowBox[{"j", "\[LessEqual]", 
          RowBox[{"Length", "[", "snr", "]"}]}], ",", 
         RowBox[{"j", "++"}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"\[Rho]1", "=", 
           RowBox[{
            FractionBox[
             RowBox[{"snr", "[", 
              RowBox[{"[", "j", "]"}], "]"}], 
             RowBox[{"M", "[", 
              RowBox[{"[", "i", "]"}], "]"}]], 
            SuperscriptBox["H1", "2"]}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"cont", "=", "0"}], ";", "\[IndentingNewLine]", 
          RowBox[{"cont", "=", 
           RowBox[{"Count", "[", 
            RowBox[{"\[Rho]1", ",", 
             RowBox[{"x_", "/;", 
              RowBox[{
               RowBox[{"Re", "[", "x", "]"}], "<=", "\[Gamma]0"}]}]}], 
            "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"pr", "[", 
            RowBox[{"[", "j", "]"}], "]"}], "=", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"N", "[", 
              RowBox[{"10", 
               RowBox[{"Log10", "[", 
                RowBox[{"snr", "[", 
                 RowBox[{"[", "j", "]"}], "]"}], "]"}]}], "]"}], ",", 
             RowBox[{"N", "[", 
              RowBox[{
               RowBox[{"cont", "/", "samples"}], ",", "700"}], "]"}]}], 
